# LTE Rack OLED Configuration
# Copy this file to config.env and fill in your values
# Never commit config.env to version control!

# SNMP Configuration
SNMP_HOST=192.168.1.1
SNMP_PORT=161
SNMP_COMMUNITY=public
SNMP_VERSION=2c

# For SNMP v3 (Recommended for production)
# SNMP_VERSION=3
# SNMP_USER=your_username
# SNMP_AUTH_PROTOCOL=SHA
# SNMP_AUTH_PASSWORD=your_auth_password
# SNMP_PRIV_PROTOCOL=AES
# SNMP_PRIV_PASSWORD=your_priv_password

# Display Configuration
DISPLAY_UPDATE_INTERVAL=5
DISPLAY_WIDTH=128
DISPLAY_HEIGHT=64

# KY040 Rotary Encoder Configuration (GPIO BCM numbering)
ENCODER_CLK=17          # CLK Pin (Clock)
ENCODER_DT=27           # DT Pin (Data)
ENCODER_SW=22           # SW Pin (Switch/Button)
ENCODER_DEBOUNCE=5      # Debounce time in milliseconds

# OIDs to Monitor (RUT241 specific)
OID_SIGNAL_STRENGTH=1.3.6.1.4.1.48690.2.1.1.2.1.0
OID_NETWORK_TYPE=1.3.6.1.4.1.48690.2.1.1.3.1.0
OID_OPERATOR=1.3.6.1.4.1.48690.2.1.1.4.1.0
OID_CONNECTION_STATE=1.3.6.1.4.1.48690.2.1.1.5.1.0

# Logging
LOG_LEVEL=INFO
LOG_FILE=/var/log/lte_rack_oled.log
